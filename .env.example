# Jarvis 3.0 Configuration Environment File
# The default Ollama provider is local and requires no API keys.

# Optional Gemini API key for explicit `consult gemini: ...` requests.
# Use a key from a Google AI Studio Free-tier project; that tier has model-specific quotas.
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (used when llm.provider is "groq")
GROQ_API_KEY=your_groq_api_key_here

# OmniRoute API Key (used when llm.provider is "omniroute")
OMNIROUTE_API_KEY=your_omniroute_api_key_here

# xAI Grok API key (metered API; disabled unless allow_metered_api_calls is enabled).
GROK_API_KEY=your_xai_grok_api_key_here
XAI_API_KEY=your_xai_api_key_here

# Anthropic Claude API key (metered after any introductory credits; disabled by default).
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gmail Integration (Free App Password from: https://myaccount.google.com/apppasswords)
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Outlook Integration (App password from: https://account.live.com/proofs/manage/additional)
OUTLOOK_ADDRESS=your_email@outlook.com
OUTLOOK_APP_PASSWORD=your_outlook_app_password
