# Jarvis 2.0 Configuration Environment File
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail Integration (Free App Password from: https://myaccount.google.com/apppasswords)
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Outlook Integration (App password from: https://account.live.com/proofs/manage/additional)
OUTLOOK_ADDRESS=your_email@outlook.com
OUTLOOK_APP_PASSWORD=your_outlook_app_password
