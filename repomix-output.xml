<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JARVIS 3.0 // Holographic HUD Interface</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800;900&family=Rajdhani:wght@500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-dark: #050811;
      --panel-bg: rgba(8, 14, 26, 0.78);
      --panel-border: rgba(0, 240, 255, 0.28);
      --holo-cyan: #00f0ff;
      --holo-blue: #00b4d8;
      --holo-amber: #ffaa00;
      --holo-emerald: #00e199;
      --holo-crimson: #ff3366;
      --text-main: #e2f1f8;
      --text-dim: #7a92a3;
      --glow-cyan: 0 0 15px rgba(0, 240, 255, 0.45);
      --glow-amber: 0 0 18px rgba(255, 170, 0, 0.55);
      --glow-emerald: 0 0 18px rgba(0, 225, 153, 0.55);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
    }

    body {
      background-color: var(--bg-dark);
      background-image: 
        radial-gradient(circle at 50% 50%, rgba(0, 180, 216, 0.08) 0%, transparent 70%),
        linear-gradient(rgba(0, 240, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 240, 255, 0.03) 1px, transparent 1px);
      background-size: 100% 100%, 36px 36px, 36px 36px;
      color: var(--text-main);
      font-family: 'Rajdhani', 'Segoe UI', sans-serif;
      height: 100vh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      position: relative;
    }

    /* Scanline effect */
    body::after {
      content: "";
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%);
      background-size: 100% 4px;
      z-index: 100;
      pointer-events: none;
      opacity: 0.45;
    }

    /* Header Bar */
    header {
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 28px;
      border-bottom: 1px solid var(--panel-border);
      background: rgba(5, 9, 18, 0.85);
      backdrop-filter: blur(12px);
      z-index: 10;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .brand-logo {
      width: 28px;
      height: 28px;
      border: 2px solid var(--holo-cyan);
      border-radius: 50%;
      display: grid;
      place-items: center;
      box-shadow: var(--glow-cyan);
    }

    .brand-logo-inner {
      width: 10px;
      height: 10px;
      background: var(--holo-cyan);
      border-radius: 50%;
    }

    .brand-title {
      font-family: 'Orbitron', sans-serif;
      font-weight: 800;
      font-size: 1.15rem;
      letter-spacing: 2px;
      color: var(--holo-cyan);
      text-shadow: var(--glow-cyan);
    }

    .brand-sub {
      font-size: 0.82rem;
      letter-spacing: 1.5px;
      color: var(--text-dim);
      border-left: 1px solid var(--panel-border);
      padding-left: 12px;
      margin-left: 6px;
    }

    .header-pills {
      display: flex;
      align-items: center;
      gap: 12px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.8rem;
    }

    .pill {
      background: rgba(0, 240, 255, 0.08);
      border: 1px solid var(--panel-border);
      padding: 6px 14px;
      border-radius: 4px;
      display: flex;
      align-items: center;
      gap: 8px;
      letter-spacing: 1px;
    }

    .pill-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--holo-emerald);
      box-shadow: 0 0 8px var(--holo-emerald);
    }

    /* Main Grid Layout */
    main {
      flex: 1;
      min-height: 0;
      display: grid;
      grid-template-columns: minmax(280px, 330px) minmax(320px, 1fr) minmax(340px, 420px);
      grid-template-rows: minmax(0, 1fr) auto;
      gap: 16px;
      padding: 16px 20px 14px 20px;
      overflow: hidden;
      z-index: 10;
    }

    /* Card Panels */
    .hud-card {
      background: var(--panel-bg);
      border: 1px solid var(--panel-border);
      border-radius: 6px;
      backdrop-filter: blur(14px);
      display: flex;
      flex-direction: column;
