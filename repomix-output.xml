          .finally(() => {
            if (btn) btn.disabled = false;
          });
      } else if (pendingDeleteCalendarId) {
        const clearCheckbox = document.getElementById('confirmClearEventsCheckbox');
        const clearEvents = clearCheckbox ? clearCheckbox.checked : false;

        fetch('/api/calendar/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ doc_id: pendingDeleteCalendarId, clear_events: clearEvents })
        })
          .then(res => res.json())
          .then(data => {
            closeConfirmModal();
            currentCalendarFilter = null;
            loadCalendarModalData();
            if (activeDrawerTab === 'agenda') loadDrawerContent();
          })
          .catch(err => {
            console.error("Error deleting calendar document:", err);
            closeConfirmModal();
          })
          .finally(() => {
            if (btn) btn.disabled = false;
          });
      }
