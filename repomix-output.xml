            """)
            conn.execute("""
                CREATE TRIGGER IF NOT EXISTS obsidian_chunks_au AFTER UPDATE ON obsidian_chunks BEGIN
                    INSERT INTO obsidian_chunks_fts(obsidian_chunks_fts, rowid, note_title, breadcrumb, content, tags, wiki_links)
