          <button class="btn-action" onclick="sendQuickCommand('Jarvis, give me my daily briefing')">
            <span>🌅</span> BRIEFING
          </button>
          <button class="btn-action" onclick="sendQuickCommand('Jarvis, initiate lockdown protocol')">
