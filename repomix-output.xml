      margin-top: 6px;
      overflow: hidden;
      border: 1px solid rgba(0, 240, 255, 0.2);
    }

    .meter-bar {
      height: 100%;
      width: 100%;
      background: linear-gradient(90deg, var(--holo-blue), var(--holo-cyan));
      transform: scaleX(0);
