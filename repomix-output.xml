          <span class="telemetry-label">HOST OS</span>
          <span class="telemetry-val" id="osVal">WINDOWS 11 64-BIT</span>
        </div>
        <div class="telemetry-row">
          <span class="telemetry-label">GPU STATUS</span>
          <div style="display: flex; gap: 6px; align-items: center;">
