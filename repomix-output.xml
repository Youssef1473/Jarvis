      const backdrop = document.getElementById('calConfirmBackdrop');
      if (backdrop) backdrop.classList.remove('open');
      pendingDeleteCalendarId = null;
      pendingDeleteCalendarTitle = "";
    }

    function executeDeleteCalendar() {
      const btn = document.getElementById('btnExecuteDelete');
      if (btn) btn.disabled = true;

      if (pendingDeleteCalendarId === 'ALL') {
        fetch('/api/calendar/clear', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({})
        })
          .then(res => res.json())
          .then(data => {
            closeConfirmModal();
            loadCalendarModalData();
            if (activeDrawerTab === 'agenda') loadDrawerContent();
          })
          .catch(err => {
            console.error("Error clearing calendar events:", err);
            closeConfirmModal();
