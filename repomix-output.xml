        is_fast_reflex = bool(self.brain._try_fast_reflex(norm_query))
        is_model_switch = bool(re.match(r"^(?:switch to|use|activate|set model to|enable)\s+(pro|flash|claude|sonnet|opus|gemini|3\.8|3\.1)", norm_query, re.I))

