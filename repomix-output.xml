    // Canvas Setup
    const canvas = document.getElementById('reactorCanvas');
    const ctx = canvas.getContext('2d');
    const size = 480;
    const center = size / 2;

    function renderArcReactor() {
      ctx.clearRect(0, 0, size, center * 2);

      // Determine state colors and dynamics
      let coreColor = "#00f0ff";
      let glowColor = "rgba(0, 240, 255, 0.6)";
      let speedMult = 1.0;

      if (isMuted) {
        coreColor = "#ff3366";
        glowColor = "rgba(255, 51, 102, 0.6)";
        speedMult = 0.2;
      } else if (currentState === "listening") {
        coreColor = "#00f0ff";
        glowColor = "rgba(0, 240, 255, 0.9)";
        speedMult = 2.2;
      } else if (currentState === "thinking") {
        coreColor = "#ffaa00";
        glowColor = "rgba(255, 170, 0, 0.85)";
        speedMult = 4.0;
      } else if (currentState === "speaking") {
        coreColor = "#00e199";
        glowColor = "rgba(0, 225, 153, 0.85)";
        speedMult = 2.0;
      } else { // idle
        coreColor = "#00b4d8";
        glowColor = "rgba(0, 180, 216, 0.4)";
        speedMult = 0.6;
      }

      // Dynamic rotation increments
      turbineAngle1 += 0.008 * speedMult;
      turbineAngle2 -= 0.014 * speedMult;
      turbineAngle3 += 0.022 * speedMult;
      pulseAngle += 0.04;

      const dynamicRadiusMod = 1.0 + (0.05 * Math.sin(pulseAngle)) + (audioReactiveLevel * 0.12);

      // 1. Outermost Ambient Ring
      ctx.beginPath();
      ctx.arc(center, center, 190 * dynamicRadiusMod, 0, 2 * Math.PI);
      ctx.strokeStyle = "rgba(0, 240, 255, 0.12)";
      ctx.lineWidth = 1;
      ctx.stroke();

      // 2. Audio-Reactive Equalizer Frequency Ring (36 radial notches)
      const numNotches = 36;
      for (let i = 0; i < numNotches; i++) {
        const notchAngle = (i * 2 * Math.PI / numNotches) + turbineAngle1;
        const baseLen = 8;
        const waveLen = (currentState === "speaking" || currentState === "listening")
          ? baseLen + (Math.sin(pulseAngle * 2 + i) * 6) + (audioReactiveLevel * 14)
          : baseLen;
        const r1 = 175 * dynamicRadiusMod;
        const r2 = r1 + waveLen;

        const x1 = center + r1 * Math.cos(notchAngle);
        const y1 = center + r1 * Math.sin(notchAngle);
        const x2 = center + r2 * Math.cos(notchAngle);
        const y2 = center + r2 * Math.sin(notchAngle);

        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.strokeStyle = glowColor;
        ctx.lineWidth = 2;
        ctx.stroke();
      }

      // 3. Middle Turbine Ring 1 (6 Segmented Arcs)
      const numArcs1 = 6;
      for (let i = 0; i < numArcs1; i++) {
        const start = turbineAngle2 + (i * 2 * Math.PI / numArcs1);
        const end = start + (Math.PI / 5);
        ctx.beginPath();
        ctx.arc(center, center, 142 * dynamicRadiusMod, start, end);
        ctx.strokeStyle = coreColor;
        ctx.lineWidth = 4;
        ctx.shadowColor = coreColor;
        ctx.shadowBlur = 12;
        ctx.stroke();
        ctx.shadowBlur = 0;
      }

      // 4. Inner Turbine Ring 2 (Counter-Rotating Arcs)
      const numArcs2 = 4;
      for (let i = 0; i < numArcs2; i++) {
        const start = turbineAngle3 + (i * 2 * Math.PI / numArcs2);
        const end = start + (Math.PI / 3);
        ctx.beginPath();
        ctx.arc(center, center, 98 * dynamicRadiusMod, start, end);
        ctx.strokeStyle = glowColor;
        ctx.lineWidth = 3;
        ctx.stroke();
      }

      // 5. Central Reactor Core Housing
      ctx.beginPath();
      ctx.arc(center, center, 62 * dynamicRadiusMod, 0, 2 * Math.PI);
      ctx.strokeStyle = coreColor;
      ctx.lineWidth = 2;
      ctx.shadowColor = coreColor;
      ctx.shadowBlur = 18;
      ctx.stroke();
      ctx.shadowBlur = 0;

      // 6. Glowing Inner Reactor Core Fill
      const grad = ctx.createRadialGradient(center, center, 0, center, center, 56 * dynamicRadiusMod);
      grad.addColorStop(0, "#ffffff");
      grad.addColorStop(0.3, coreColor);
      grad.addColorStop(1.0, "rgba(0, 0, 0, 0.4)");

      ctx.beginPath();
      ctx.arc(center, center, 54 * dynamicRadiusMod, 0, 2 * Math.PI);
      ctx.fillStyle = grad;
      ctx.fill();

      // 7. Core Radial Rays
      const numRays = 8;
      for (let i = 0; i < numRays; i++) {
        const rayAngle = (i * 2 * Math.PI / numRays) + turbineAngle1;
        const rx = center + 50 * Math.cos(rayAngle);
        const ry = center + 50 * Math.sin(rayAngle);
        ctx.beginPath();
        ctx.moveTo(center, center);
        ctx.lineTo(rx, ry);
        ctx.strokeStyle = "rgba(255, 255, 255, 0.6)";
        ctx.lineWidth = 1.5;
        ctx.stroke();
      }

      // 8. Center Arc Core Dot
      ctx.beginPath();
      ctx.arc(center, center, 14, 0, 2 * Math.PI);
      ctx.fillStyle = "#ffffff";
      ctx.shadowColor = coreColor;
      ctx.shadowBlur = 24;
      ctx.fill();
      ctx.shadowBlur = 0;

      requestAnimationFrame(renderArcReactor);
    }
    requestAnimationFrame(renderArcReactor);

    // Resilient WebSocket Client with Exponential Backoff
    function initWebSocket() {
      if (ws && (ws.readyState === WebSocket.OPEN || ws.readyState === WebSocket.CONNECTING)) {
        return;
      }
      if (reconnectTimeout) {
        clearTimeout(reconnectTimeout);
        reconnectTimeout = null;
      }

      const proto = window.location.protocol === "https:" ? "wss:" : "ws:";
      const wsUrl = `${proto}//${window.location.host}/ws`;

      try {
        ws = new WebSocket(wsUrl);
      } catch (err) {
        console.warn("[WS] Init failed, scheduling reconnect:", err);
        scheduleWsReconnect();
        return;
      }

      ws.onopen = () => {
        reconnectAttempts = 0;
        if (reconnectTimeout) {
          clearTimeout(reconnectTimeout);
          reconnectTimeout = null;
        }
        if (domRefs.socketStatusDot) {
          domRefs.socketStatusDot.style.background = "var(--holo-emerald)";
          domRefs.socketStatusDot.style.boxShadow = "0 0 8px var(--holo-emerald)";
        }
        if (domRefs.socketStatusText) {
          domRefs.socketStatusText.textContent = "NEURAL LINK ACTIVE";
        }
      };

      ws.onmessage = (event) => {
        try {
          const data = JSON.parse(event.data);
          handleServerMessage(data);
        } catch (e) {
          console.error("Malformed WS payload:", e);
        }
      };

      ws.onclose = () => {
        if (domRefs.socketStatusDot) {
          domRefs.socketStatusDot.style.background = "var(--holo-crimson)";
          domRefs.socketStatusDot.style.boxShadow = "0 0 8px var(--holo-crimson)";
        }
        if (domRefs.socketStatusText) {
          domRefs.socketStatusText.textContent = "DISCONNECTED // RECONNECTING";
        }
        scheduleWsReconnect();
      };

      ws.onerror = (err) => {
        console.warn("WebSocket error:", err);
      };
    }

    function scheduleWsReconnect() {
      if (reconnectTimeout) return;
      const delay = Math.min(
        MAX_RECONNECT_DELAY_MS,
        INITIAL_RECONNECT_DELAY_MS * Math.pow(BACKOFF_MULTIPLIER, reconnectAttempts)
      );
      reconnectAttempts++;
      if (domRefs.socketStatusText) {
        domRefs.socketStatusText.textContent = `LINK DOWN // RETRYING (${Math.round(delay / 1000)}s)`;
      }
      reconnectTimeout = setTimeout(() => {
        reconnectTimeout = null;
        initWebSocket();
      }, delay);
    }

    function handleServerMessage(data) {
      if (data.type === "state") {
        updateHUDState(data.state);
      } else if (data.type === "telemetry" || data.c !== undefined || data.cpu !== undefined) {
        updateTelemetry(data);
      } else if (data.type === "chat") {
        appendChatMessage(data.sender, data.text, data.timestamp);
      } else if (data.type === "audio_level") {
        audioReactiveLevel = data.level || 0.0;
      } else if (data.type === "document_staged") {
        updateStagedBadge(data.filename);
        appendChatMessage("jarvis", data.message || `Received '${data.filename}', Sir. Standing by for your briefing.`);
      } else if (data.type === "screen_snapshot") {
        appendScreenSnapshotBubble(data.url, data.timestamp);
      } else if (data.type === "ambient_telemetry") {
        handleAmbientTelemetry(data.data, data.timestamp);
      }
    }

    function updateHUDState(state) {
      currentState = state;
      const badge = domRefs.statusBadge || document.getElementById('statusBadge');
      const sub = domRefs.subStatus || document.getElementById('subStatus');
      if (!badge || !sub) return;

      if (isMuted) {
        badge.textContent = "MUTED // SENSORS OFFLINE";
        badge.style.color = "var(--holo-crimson)";
        badge.style.borderColor = "var(--holo-crimson)";
        badge.style.textShadow = "0 0 15px rgba(255, 51, 102, 0.6)";
        sub.textContent = "MICROPHONE MUTED // CLICK UNMUTE TO RESTORE VOICE";
        return;
      }

      if (state === "listening") {
        badge.textContent = "LISTENING // VOX ACTIVE";
        badge.style.color = "var(--holo-cyan)";
        badge.style.borderColor = "var(--holo-cyan)";
        badge.style.textShadow = "var(--glow-cyan)";
        sub.textContent = "RECORDING SPEECH // VOICE ACTIVITY DETECTOR ARMED";
      } else if (state === "thinking") {
        badge.textContent = "PROCESSING // NEURAL LPU";
        badge.style.color = "var(--holo-amber)";
        badge.style.borderColor = "var(--holo-amber)";
        badge.style.textShadow = "var(--glow-amber)";
        sub.textContent = "LOCAL REASONING & TOOL ROUTING // NO AUTOMATIC CLOUD FALLBACK";
      } else if (state === "speaking") {
        badge.textContent = "SPEAKING // VOCAL HARMONICS";
        badge.style.color = "var(--holo-emerald)";
        badge.style.borderColor = "var(--holo-emerald)";
        badge.style.textShadow = "var(--glow-emerald)";
        sub.textContent = "SYNTHESIZING & STREAMING VIA KOKORO-82M NEURAL VOICE";
      } else { // idle
        badge.textContent = "STANDBY // ONLINE";
        badge.style.color = "var(--holo-cyan)";
        badge.style.borderColor = "var(--panel-border)";
        badge.style.textShadow = "var(--glow-cyan)";
        sub.textContent = "HOLD FIN KEY OR SAY 'HEY JARVIS' TO ACTIVATE";
      }
    }

    // Telemetry Batching via requestAnimationFrame & Zero-CLS GPU Compositor Updates
    let pendingTelemetry = null;
    let telemetryRafScheduled = false;

    function updateTelemetry(data) {
      if (!data) return;
      if (!pendingTelemetry) {
        pendingTelemetry = { ...data };
      } else {
        Object.assign(pendingTelemetry, data);
      }

      if (!telemetryRafScheduled) {
        telemetryRafScheduled = true;
        requestAnimationFrame(renderTelemetryFrame);
      }
    }

    function renderTelemetryFrame() {
      telemetryRafScheduled = false;
      if (!pendingTelemetry) return;
      const data = pendingTelemetry;
      pendingTelemetry = null;

      // 1. CPU Load (Single-char 'c' with fallback to 'cpu')
      const cpu = data.c !== undefined ? data.c : data.cpu;
      if (cpu !== undefined) {
        if (domRefs.cpuVal) domRefs.cpuVal.textContent = `${cpu}%`;
        if (domRefs.cpuMeter) {
          const ratio = Math.min(1, Math.max(0, cpu / 100));
          domRefs.cpuMeter.style.transform = `scaleX(${ratio})`;
        }
      }

      // 2. RAM Load (Single-char 'rp', 'ru', 'rt' with fallbacks to 'ram_pct', 'ram_used_gb', etc.)
      const ramPct = data.rp !== undefined ? data.rp : data.ram_pct;
      if (ramPct !== undefined) {
        let ramText = `${ramPct}%`;
        if (data.ru !== undefined && data.rt !== undefined) {
          const usedGb = (data.ru / 1024).toFixed(1);
          const totalGb = (data.rt / 1024).toFixed(1);
          ramText = `${usedGb} / ${totalGb} GB (${ramPct}%)`;
        } else if (data.ram_used_gb !== undefined && data.ram_total_gb !== undefined) {
          ramText = `${data.ram_used_gb} / ${data.ram_total_gb} GB (${ramPct}%)`;
        }
        if (domRefs.ramVal) domRefs.ramVal.textContent = ramText;
        if (domRefs.ramMeter) {
          const ratio = Math.min(1, Math.max(0, ramPct / 100));
          domRefs.ramMeter.style.transform = `scaleX(${ratio})`;
        }
      }

      // 3. System Battery
      if (data.battery !== undefined) {
        const bText = `${data.battery}% ${data.charging ? '⚡' : ''}`;
        if (domRefs.batteryVal) domRefs.batteryVal.textContent = bText;
        if (domRefs.batteryMeter) {
          const ratio = Math.min(1, Math.max(0, data.battery / 100));
          domRefs.batteryMeter.style.transform = `scaleX(${ratio})`;
        }
      }

      // 4. GPU Thermals & Load (Single-char 'gt', 'gp', 'gl' with fallbacks)
      const gpuTemp = data.gt !== undefined ? data.gt : data.gpu_temp;
      if (gpuTemp !== undefined && gpuTemp > 0 && domRefs.gpuTempBadge) {
        domRefs.gpuTempBadge.textContent = `${gpuTemp}°C`;
        if (gpuTemp > 80) {
          domRefs.gpuTempBadge.style.color = 'var(--holo-crimson)';
          domRefs.gpuTempBadge.style.borderColor = 'var(--holo-crimson)';
        } else {
          domRefs.gpuTempBadge.style.color = 'var(--holo-amber)';
          domRefs.gpuTempBadge.style.borderColor = 'var(--holo-amber)';
        }
      }

      const gpuLoad = data.gp !== undefined ? data.gp : (data.gl !== undefined ? data.gl : data.gpu_load);
      const gpuName = data.gpu || data.gpu_name;
      if (domRefs.gpuVal) {
        if (gpuName && gpuLoad !== undefined && gpuLoad > 0) {
          domRefs.gpuVal.textContent = `${gpuName} (${gpuLoad}%)`;
        } else if (gpuName) {
          domRefs.gpuVal.textContent = gpuName;
        }
      }

      // 5. Cognitive Model & Tier (Single-char 'md', 'st')
      const modelVal = data.md !== undefined ? data.md : data.model;
      if (modelVal && domRefs.activeModelVal) {
        domRefs.activeModelVal.textContent = modelVal;
      }

      if (data.tier && domRefs.modelTierVal) {
        domRefs.modelTierVal.textContent = data.tier.toUpperCase();
      }

      // 6. State synchronization (Single-char 'st' with fallback to 'state')
      const stateVal = data.st !== undefined ? data.st : data.state;
      if (stateVal && stateVal !== currentState) {
        updateHUDState(stateVal);
      }

      // 7. Latencies
      if (data.latencies && domRefs.latencyBadge) {
        const l = data.latencies;
        const oMs = l.ollama ? `${Math.round(l.ollama)}ms` : '--';
        const gMs = l.groq ? `${Math.round(l.groq)}ms` : '--';
        domRefs.latencyBadge.textContent = `OLLAMA: ${oMs} | GROQ: ${gMs}`;
      }

      // 8. Memory Label
      if (data.memory_label && domRefs.memoryCountVal) {
        domRefs.memoryCountVal.textContent = data.memory_label;
      }

      // 9. Active Timers
      if (data.active_timers !== undefined) {
        if (domRefs.activeTimersVal) domRefs.activeTimersVal.textContent = `${data.active_timers} ACTIVE`;
        if (domRefs.drawerTimerCount) domRefs.drawerTimerCount.textContent = data.active_timers;
      }

      // 10. Mute State (Single-char 'm' [0 or 1] with fallback to 'is_muted')
      const muteVal = data.m !== undefined ? Boolean(data.m === 1 || data.m === true) : data.is_muted;
      if (muteVal !== undefined && muteVal !== isMuted) {
        isMuted = muteVal;
        if (domRefs.btnMute && domRefs.muteText) {
          if (isMuted) {
            domRefs.btnMute.classList.add('muted');
            domRefs.muteText.textContent = "UNMUTE VOX";
          } else {
            domRefs.btnMute.classList.remove('muted');
            domRefs.muteText.textContent = "MUTE VOX";
          }
        }
        updateHUDState(currentState);
      }
    }

