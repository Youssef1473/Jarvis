      } else if (data.event === "calendar_countdown") {
        updateCalendarCountdownPill(data);
      } else if (data.event === "ergonomic_break") {
        showErgonomicPill(data);
      }
    }

    function updateCalendarCountdownPill(data) {
      let pill = document.getElementById('calendarCountdownPill');
      if (!pill) {
        const sub = document.getElementById('subStatus');
        if (sub && sub.parentNode) {
          pill = document.createElement('div');
          pill.id = 'calendarCountdownPill';
          pill.className = 'staged-doc-pill';
          pill.style.borderColor = 'var(--holo-amber)';
          pill.style.color = 'var(--holo-amber)';
          pill.style.marginTop = '6px';
          sub.parentNode.insertBefore(pill, sub.nextSibling);
        }
      }
      if (pill) {
        pill.style.display = 'inline-flex';
        pill.innerHTML = `<span>📅</span> <span>UPCOMING: ${escapeHtml(data.title)} in ${data.minutes_remaining}m</span>`;
      }
    }

    function showErgonomicPill(data) {
      let pill = document.getElementById('ergonomicPill');
      if (!pill) {
        const sub = document.getElementById('subStatus');
        if (sub && sub.parentNode) {
          pill = document.createElement('div');
          pill.id = 'ergonomicPill';
          pill.className = 'staged-doc-pill';
          pill.style.borderColor = 'var(--holo-emerald)';
          pill.style.color = 'var(--holo-emerald)';
          pill.style.marginTop = '6px';
          sub.parentNode.insertBefore(pill, sub.nextSibling);
        }
      }
      if (pill) {
        pill.style.display = 'inline-flex';
        pill.innerHTML = `<span>☕</span> <span>ERGONOMIC NOTICE: ${data.continuous_active_minutes}m active work. Take a brief stretch.</span>`;
        setTimeout(() => { if (pill) pill.style.display = 'none'; }, 20000);
      }
    }

    function escapeHtml(string) {
      return String(string)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function transmitCommand() {
      const input = document.getElementById('cmdInput');
      const query = input.value.trim();
      if (!query) return;

      input.value = '';

      if (ws && ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({ type: 'command', text: query }));
      } else {
        // Fallback to REST endpoint
        fetch('/api/command', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ command: query })
        })
        .then(res => res.json())
        .catch(err => console.error("REST transmit error:", err));
      }
    }

    function sendQuickCommand(cmd) {
      document.getElementById('cmdInput').value = cmd;
      transmitCommand();
    }

    function setVolume(pct) {
      if (ws && ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({ type: 'action', action: 'set_volume', percent: pct }));
      } else {
        fetch('/api/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'set_volume', percent: pct })
        });
      }
    }

    function toggleMute() {
      if (ws && ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({ type: 'action', action: 'toggle_mute' }));
      } else {
        fetch('/api/mute', { method: 'POST' });
      }
    }

    // PDF Document Import & Context Staging
    function triggerPdfImport() {
      const input = document.getElementById('pdfFileInput');
      if (input) {
        input.value = '';
        input.click();
      }
    }

    async function handlePdfUpload(event) {
      const file = event.target.files[0];
      if (!file) return;

      appendChatMessage('system', `Importing '${file.name}' via file explorer...`);

      const formData = new FormData();
      formData.append('file', file);

      try {
        const res = await fetch('/api/documents/upload', {
          method: 'POST',
          body: formData
        });
        const data = await res.json();
        if (res.ok) {
          appendChatMessage('jarvis', `Document '${file.name}' staged successfully, Sir. Standing by for your context and instructions.`);
          updateStagedBadge(file.name);
        } else {
          appendChatMessage('system', `Failed to stage document: ${data.error || 'Unknown error'}`);
        }
      } catch (err) {
        appendChatMessage('system', `Network error uploading document: ${err.message}`);
      }
    }

    function updateStagedBadge(filename) {
      const pill = document.getElementById('stagedDocPill');
      const text = document.getElementById('stagedDocText');
      if (pill && text) {
        if (filename) {
          text.textContent = `STAGED: ${filename} (Awaiting Briefing)`;
          pill.style.display = 'inline-flex';
        } else {
          pill.style.display = 'none';
        }
      }
    }

    function focusContextInput() {
      const cmd = document.getElementById('cmdInput');
      if (cmd) {
        cmd.value = "Jarvis, that PDF is ";
        cmd.focus();
      }
    }

    function checkStagedDocuments() {
      fetch('/api/documents/staged')
        .then(res => res.json())
        .then(data => {
          const docs = data.staged || [];
          const drawerCount = document.getElementById('drawerStagedCount');
          if (drawerCount) drawerCount.textContent = docs.length;

          const telemStaged = document.getElementById('telemetryStagedVal');
          if (telemStaged) {
            telemStaged.textContent = docs.length > 0 ? `${docs.length} PENDING` : '0 PENDING';
            telemStaged.style.color = docs.length > 0 ? 'var(--holo-amber)' : 'var(--holo-emerald)';
          }

          if (docs.length > 0) {
            updateStagedBadge(docs[0].filename);
          } else {
            updateStagedBadge(null);
          }
        })
        .catch(() => {});
    }

    // Auto-fetch initial telemetry
    function fetchInitialTelemetry() {
      fetch('/api/status')
        .then(res => res.json())
        .then(data => updateTelemetry(data))
        .catch(err => console.log("Initial telemetry poll:", err));
    }

    window.addEventListener('load', () => {
      initDomReferences();
      initWebSocket();
      fetchInitialTelemetry();
      checkStagedDocuments();

      // Fallback polling loop if WebSocket connection is lost or offline
      setInterval(() => {
        if (!ws || ws.readyState !== WebSocket.OPEN) {
          fetchInitialTelemetry();
        }
      }, 3000);

      // Periodic check for staged documents
      setInterval(() => {
        checkStagedDocuments();
      }, 5000);

      // Auto-refresh countdown timers when drawer is open
      setInterval(() => {
        if (isDrawerOpen && activeDrawerTab === 'timers') {
          loadDrawerContent();
        }
      }, 1500);
    });
  </script>
