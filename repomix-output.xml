  <!-- Holographic Confirmation Modal for Calendar Deletion -->
  <div id="calConfirmBackdrop" class="calendar-modal-backdrop" style="z-index: 2600;" onclick="if(event.target === this) closeConfirmModal()">
    <div class="calendar-modal-dialog" style="max-width: 520px; border-color: var(--holo-crimson); box-shadow: 0 0 45px rgba(255, 51, 102, 0.4);">
      <div class="cal-modal-header" style="background: rgba(255, 51, 102, 0.08); border-bottom-color: rgba(255, 51, 102, 0.3);">
        <div class="cal-header-left">
          <span style="font-size: 1.5rem;">⚠️</span>
