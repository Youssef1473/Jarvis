CRITICAL_PROCESS_DENYLIST = {
    "explorer.exe", "python.exe", "pythonw.exe", "svchost.exe", "csrss.exe",
    "winlogon.exe", "lsass.exe", "dwm.exe", "services.exe", "system", "smss.exe",
