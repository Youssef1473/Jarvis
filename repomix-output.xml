  <!-- Interactive HUD Script -->
  <script>
    // System & Animation State
    let currentState = "idle";
    let pulseAngle = 0;
    let turbineAngle1 = 0;
    let turbineAngle2 = 0;
    let turbineAngle3 = 0;
    let audioReactiveLevel = 0.0;
    let isMuted = false;
    let ws = null;
    let reconnectTimeout = null;
    let reconnectAttempts = 0;
    const INITIAL_RECONNECT_DELAY_MS = 1000;
    const MAX_RECONNECT_DELAY_MS = 16000;
    const BACKOFF_MULTIPLIER = 1.6;

    // DOM Reference Cache (Zero-Lookup Overhead)
    const domRefs = {};

    function initDomReferences() {
      domRefs.clockDisplay = document.getElementById('clockDisplay');
      domRefs.reactorCanvas = document.getElementById('reactorCanvas');
      domRefs.socketStatusDot = document.getElementById('socketStatusDot');
      domRefs.socketStatusText = document.getElementById('socketStatusText');
      domRefs.statusBadge = document.getElementById('statusBadge');
      domRefs.subStatus = document.getElementById('subStatus');
      domRefs.stagedDocPill = document.getElementById('stagedDocPill');
      domRefs.stagedDocText = document.getElementById('stagedDocText');
      domRefs.osVal = document.getElementById('osVal');
      domRefs.gpuVal = document.getElementById('gpuVal');
      domRefs.gpuTempBadge = document.getElementById('gpuTempBadge');
      domRefs.cpuVal = document.getElementById('cpuVal');
      domRefs.cpuMeter = document.getElementById('cpuMeter');
      domRefs.ramVal = document.getElementById('ramVal');
      domRefs.ramMeter = document.getElementById('ramMeter');
      domRefs.batteryVal = document.getElementById('batteryVal');
      domRefs.batteryMeter = document.getElementById('batteryMeter');
      domRefs.modelTierVal = document.getElementById('modelTierVal');
      domRefs.activeModelVal = document.getElementById('activeModelVal');
      domRefs.latencyBadge = document.getElementById('latencyBadge');
      domRefs.memoryCountVal = document.getElementById('memoryCountVal');
      domRefs.activeTimersVal = document.getElementById('activeTimersVal');
      domRefs.telemetryStagedVal = document.getElementById('telemetryStagedVal');
      domRefs.chatContainer = document.getElementById('chatContainer');
      domRefs.msgCount = document.getElementById('msgCount');
      domRefs.btnMute = document.getElementById('btnMute');
      domRefs.muteText = document.getElementById('muteText');
      domRefs.muteIcon = document.getElementById('muteIcon');
      domRefs.cmdInput = document.getElementById('cmdInput');
      domRefs.hudDrawer = document.getElementById('hudDrawer');
      domRefs.drawerBody = document.getElementById('drawerBody');
      domRefs.drawerTimerCount = document.getElementById('drawerTimerCount');
      domRefs.drawerStagedCount = document.getElementById('drawerStagedCount');
      domRefs.tabTimersBtn = document.getElementById('tabTimersBtn');
      domRefs.tabNotesBtn = document.getElementById('tabNotesBtn');
      domRefs.tabStagedBtn = document.getElementById('tabStagedBtn');
      domRefs.tabAgendaBtn = document.getElementById('tabAgendaBtn');
      domRefs.pdfFileInput = document.getElementById('pdfFileInput');
      domRefs.calendarModalBackdrop = document.getElementById('calendarModalBackdrop');
