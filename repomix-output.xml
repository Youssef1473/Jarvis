    .bubble-text {
      color: var(--text-main);
      word-break: break-word;
    }

    /* Bottom Command Deck */
    /* Bottom Command Deck */
    .command-deck {
      grid-column: 1 / -1;
      display: flex;
      flex-direction: column;
