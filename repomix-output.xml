    assert "Hello Sir, action required on server 3." in clean
    print("HTML stripping: PASSED")

    # 2. ANSI escape code stripping
    ansi_raw = "\x1B[31mDangerous red text\x1B[0m and \x1B[1mBold\x1B[0m"
