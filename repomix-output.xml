    function handleAmbientTelemetry(data, timestamp) {
      if (!data) return;
      const now = timestamp || new Date().toLocaleTimeString('en-GB');
      if (data.event === "task_completed") {
        const container = document.getElementById('chatContainer');
        if (!container) return;
        const bubble = document.createElement('div');
