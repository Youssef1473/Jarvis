          <button class="btn-action" id="btnGallery" onclick="openPhotoGalleryModal()" style="border-color: rgba(0, 240, 255, 0.5); color: var(--holo-cyan);" title="Open Archived Visual Intel Matrix">
            <span>🖼️</span> GALLERY
          </button>
          <button class="btn-action" id="btnCalendar" onclick="openCalendarModal()" style="border-color: rgba(0, 240, 255, 0.5); color: var(--holo-cyan);" title="Open Holographic Tactical Calendar">
            <span>📅</span> CALENDAR
