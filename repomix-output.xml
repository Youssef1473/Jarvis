        { name: "WEDNESDAY", date: "2026-10-14", displayDate: "Oct 14" },
        { name: "THURSDAY", date: "2026-10-15", displayDate: "Oct 15" },
        { name: "FRIDAY", date: "2026-10-16", displayDate: "Oct 16" },
        { name: "SATURDAY", date: "2026-10-17", displayDate: "Oct 17" },
        { name: "SUNDAY", date: "2026-10-18", displayDate: "Oct 18" },
