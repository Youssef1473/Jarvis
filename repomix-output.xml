            <div class="cal-title" style="color: var(--holo-crimson); text-shadow: 0 0 10px rgba(255, 51, 102, 0.6);">// PURGE CALENDAR ARCHIVE</div>
            <div class="cal-subtitle">IRREVERSIBLE MEMORY MODIFICATION PROTOCOL</div>
