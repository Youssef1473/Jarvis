    // Calendar Deletion Controller
    let pendingDeleteCalendarId = null;
    let pendingDeleteCalendarTitle = "";

    function escapeJs(str) {
      if (!str) return '';
      return String(str).replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '&quot;');
    }

    function promptDeleteCalendar(docId, title) {
      pendingDeleteCalendarId = docId;
      pendingDeleteCalendarTitle = title || `Calendar #${docId}`;
      const backdrop = document.getElementById('calConfirmBackdrop');
      const textEl = document.getElementById('confirmModalText');
      const wrapper = document.getElementById('confirmClearEventsWrapper');
      if (textEl) {
        textEl.innerHTML = `Are you sure you want to permanently delete calendar "<strong>${escapeHtml(pendingDeleteCalendarTitle)}</strong>" from Jarvis?`;
      }
      if (wrapper) wrapper.style.display = 'flex';
      if (backdrop) backdrop.classList.add('open');
    }

    function promptDeleteCurrentCalendar() {
      if (currentCalendarFilter === null) {
        promptClearAllEvents();
      } else if (cachedCalendarData && cachedCalendarData.saved_calendars) {
        const found = cachedCalendarData.saved_calendars.find(d => d.id === currentCalendarFilter);
        if (found) {
          promptDeleteCalendar(found.id, found.title);
        }
      }
    }

    function promptClearAllEvents() {
      pendingDeleteCalendarId = 'ALL';
      pendingDeleteCalendarTitle = 'ALL ACTIVE SCHEDULE SESSIONS';
      const backdrop = document.getElementById('calConfirmBackdrop');
      const textEl = document.getElementById('confirmModalText');
      const wrapper = document.getElementById('confirmClearEventsWrapper');
      if (textEl) {
        textEl.innerHTML = `Are you sure you want to purge <strong>ALL active schedule events</strong> from Jarvis memory?`;
      }
      if (wrapper) wrapper.style.display = 'none';
      if (backdrop) backdrop.classList.add('open');
    }

