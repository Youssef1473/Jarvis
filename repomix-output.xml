        const isSuccess = data.status === "completed";
        const statusColor = isSuccess ? "var(--holo-emerald)" : "var(--holo-crimson)";
        const badgeText = isSuccess ? "COMPLETED" : `FAILED (Exit: ${data.exit_code})`;

        bubble.innerHTML = `
          <div class="bubble-author jarvis">
            <span>BACKGROUND TASK // ${escapeHtml(data.name || data.task_id)}</span>
            <span>${now}</span>
          </div>
          <div class="bubble-text">
            <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 6px;">
              <span style="border: 1px solid ${statusColor}; color: ${statusColor}; padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; font-weight: bold; letter-spacing: 0.05em;">${badgeText}</span>
              <span style="font-size: 0.75rem; color: var(--text-dim);">Duration: ${data.duration_s}s</span>
