          let cardsHtml = '';
          if (hasClasses) {
            cardsHtml = dayEvents.map(ev => {
              const startPart = ev.start_time.replace(day.date, '').trim();
              const endPart = (ev.end_time || '').replace(day.date, '').trim();
              const timeDisplay = endPart ? `${startPart} &ndash; ${endPart}` : startPart;
              return `
                <div class="cal-event-card" onclick="sendQuickCommand('Jarvis, tell me about ${escapeHtml(ev.title)} on ${day.name}')" title="Click to ask Jarvis about this session">
                  <div class="cal-event-time">
                    <span>⏰</span> <span>${timeDisplay}</span>
