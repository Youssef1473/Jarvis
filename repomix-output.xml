<script>
/**
 * Holographic Photo Gallery Virtualized Controller
 * Strictly adheres to 0 client memory overhead and native browser HTTP 304 ETag caching.
 */
class HolographicPhotoGallery {
  constructor() {
    this.grid = document.getElementById("photoGrid");
    this.scrollContainer = document.getElementById("photoScrollContainer");
    this.counterBadge = document.getElementById("photoCounterBadge");
    this.emptyState = document.getElementById("photoEmptyState");
    this.statusMsg = document.getElementById("galleryStatusMsg");
    this.lightbox = document.getElementById("photoLightboxModal");
    
    this.photos = [];
    this.currentPhoto = null;
    this.observer = null;

    // Minimalist SVG error fallback data URI to replace broken or blocked images
    this.errorFallbackSvg = `data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 100 100" fill="none"><rect width="100" height="100" fill="%230f1420"/><path d="M50 30v25M50 68h.01" stroke="%23ff3366" stroke-width="5" stroke-linecap="round"/><circle cx="50" cy="50" r="42" stroke="%23ff3366" stroke-width="2" stroke-dasharray="4 4"/><text x="50" y="86" fill="%23ff3366" font-size="8" font-family="monospace" text-anchor="middle">PAYLOAD ERROR</text></svg>`;

    this.initObserver();
    this.loadGallery();
  }

  /**
   * Initializes the virtualized viewport IntersectionObserver.
   * Defers binary downloads until tiles enter 100px proximity to prevent thread-pool exhaustion.
   */
  initObserver() {
    const options = {
      root: this.scrollContainer,
      rootMargin: "100px 0px", // Pre-fetch 100px ahead of viewport scroll
      threshold: 0.01
    };

    this.observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const img = entry.target;
          const targetSrc = img.dataset.src;

          if (targetSrc) {
            // Initiate standard browser GET with native If-None-Match ETag check
            img.src = targetSrc;
            img.removeAttribute("data-src");
          }

          // Unobserve immediately once triggered to release observer resources
          observer.unobserve(img);
        }
      });
    }, options);
  }

  /**
   * Fetches metadata array from /api/photos and constructs virtualized grid matrix.
   */
  async loadGallery() {
    this.setStatus("FETCHING INTEL ARCHIVES...");
    try {
      const resp = await fetch("/api/photos");
      if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
      const data = await resp.json();
      this.photos = data.photos || [];

      this.counterBadge.textContent = `${this.photos.length} ASSETS`;
      this.render();
      this.setStatus(`SYNC COMPLETE (${this.photos.length} INDEXED)`);
    } catch (err) {
      console.error("[PhotoGallery] Failed to fetch archives:", err);
      this.setStatus("DATABASE SYNC ERROR");
    }
  }

  /**
   * Constructs DOM tiles with fixed aspect ratio to eliminate Cumulative Layout Shift (CLS).
   */
  render() {
    this.grid.innerHTML = "";

    if (this.photos.length === 0) {
      this.emptyState.classList.remove("hidden");
      return;
    }
    this.emptyState.classList.add("hidden");

    const fragment = document.createDocumentFragment();

    this.photos.forEach((photo) => {
      const tile = document.createElement("div");
      tile.className = "group relative aspect-square rounded overflow-hidden border border-cyan-500/25 bg-[#080e1a]/80 hover:border-cyan-400 hover:shadow-[0_0_15px_rgba(0,240,255,0.35)] transition-all duration-200 cursor-pointer img-placeholder will-change-transform";
      tile.onclick = () => this.openLightbox(photo);

      // Scanning line hover indicator
      const scanline = document.createElement("div");
      scanline.className = "absolute inset-0 bg-gradient-to-b from-transparent via-cyan-400/10 to-transparent -translate-y-full group-hover:translate-y-full transition-transform duration-700 pointer-events-none z-10";
      tile.appendChild(scanline);

      // Image element with hardware-accelerated opacity transition
      const img = document.createElement("img");
      img.className = "w-full h-full object-cover opacity-0 transition-opacity duration-300 ease-out will-change-transform";
      img.alt = photo.caption || photo.file_name;
      img.dataset.src = `/api/photos/${photo.photo_id}`;

      // Blank inline 1x1 data URI to prevent broken image icon before loading
      img.src = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E";

      // Onload: smooth fade-in
      img.onload = () => {
        img.classList.remove("opacity-0");
        img.classList.add("opacity-100");
      };

      // Onerror: replace malformed/blocked payload with fallback SVG
      img.onerror = () => {
        img.src = this.errorFallbackSvg;
        img.classList.remove("opacity-0");
        img.classList.add("opacity-100");
        tile.classList.add("border-rose-500/40");
      };

      tile.appendChild(img);

      // Bottom Overlay Badge
      const badge = document.createElement("div");
      badge.className = "absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent p-1.5 opacity-0 group-hover:opacity-100 transition-opacity text-[10px] font-mono text-cyan-300 truncate z-20 flex justify-between items-center";
      badge.innerHTML = `<span>${photo.dimensions || 'IMG'}</span><span>${Math.round((photo.file_size || 0)/1024)}K</span>`;
      tile.appendChild(badge);

      fragment.appendChild(tile);

      // Enqueue to IntersectionObserver for on-demand streaming
      this.observer.observe(img);
    });

    this.grid.appendChild(fragment);
  }

  /**
   * Opens the Lightbox inspection view for a given photo record.
   */
  openLightbox(photo) {
    this.currentPhoto = photo;
    document.getElementById("modalPhotoTitle").textContent = `INTEL // ${photo.file_name || photo.photo_id}`;
    document.getElementById("modalDim").textContent = photo.dimensions || "Unknown";
    document.getElementById("modalSize").textContent = `${Math.round((photo.file_size || 0) / 1024)} KB`;
    document.getElementById("modalDate").textContent = photo.created_at || "Recent";
    document.getElementById("modalId").textContent = photo.photo_id;

    const captionBox = document.getElementById("modalCaptionText");
    captionBox.textContent = photo.caption || "No visual description indexed. Click 'ANALYZE WITH VISION' to evaluate.";

    const img = document.getElementById("modalPhotoImg");
    img.src = `/api/photos/${photo.photo_id}`;
    img.onerror = () => { img.src = this.errorFallbackSvg; };

    this.lightbox.classList.remove("hidden");
  }

  closeLightbox() {
    this.lightbox.classList.add("hidden");
    document.getElementById("modalPhotoImg").src = "";
    this.currentPhoto = null;
  }

  /**
   * Invokes the describe_photo skill for zero-local-VRAM cloud vision analysis.
   */
  async analyzeCurrentPhoto() {
    if (!this.currentPhoto) return;
    const btn = document.getElementById("analyzeVisionBtn");
    const captionText = document.getElementById("modalCaptionText");

    btn.disabled = true;
    btn.classList.add("opacity-50", "animate-pulse");
    captionText.textContent = "Streaming visual tokens to Gemini Cloud Vision...";

    try {
      const resp = await fetch("/api/command", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ command: `describe photo ${this.currentPhoto.photo_id}` })
      });
      const data = await resp.json();
      captionText.textContent = `Analysis request dispatched (${data.status || 'queued'}). Listening for voice debrief...`;
    } catch (e) {
      captionText.textContent = `Vision analysis request failed: ${e.message}`;
    } finally {
      btn.disabled = false;
      btn.classList.remove("opacity-50", "animate-pulse");
    }
  }

  /**
   * Triggers native clipboard extraction on Windows/WSL host.
   */
  async pasteClipboard() {
    this.setStatus("EXTRACTING CLIPBOARD STREAM...");
    try {
      const resp = await fetch("/api/command", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ command: "save clipboard photo" })
      });
      this.setStatus("CLIPBOARD COMMAND SENT");
      setTimeout(() => this.loadGallery(), 1000);
    } catch (e) {
      this.setStatus("CLIPBOARD FAILED");
    }
  }

  refresh() {
    this.loadGallery();
  }

  close() {
    const root = document.getElementById("photoGalleryContainer");
    if (root) root.style.display = "none";
  }

  setStatus(msg) {
    if (this.statusMsg) this.statusMsg.textContent = msg;
  }
}

// Global initialization
let photoGallery;
document.addEventListener("DOMContentLoaded", () => {
  photoGallery = new HolographicPhotoGallery();
});
</script>
</file>

