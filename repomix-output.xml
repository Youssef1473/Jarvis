    let messageCount = 1;
    let lastMsgKey = "";
    let lastMsgTime = 0;

    function appendChatMessage(sender, text, timeStr) {
      if (!text || !text.trim()) return;

      // Deduplicate identical message from same sender within 2.0 seconds
      const cleanText = text.trim();
      const key = `${sender.toLowerCase()}:${cleanText}`;
      const nowMs = Date.now();
      if (key === lastMsgKey && (nowMs - lastMsgTime) < 2000) {
        return;
      }
      lastMsgKey = key;
      lastMsgTime = nowMs;

      const container = document.getElementById('chatContainer');
      const bubble = document.createElement('div');
      bubble.className = `chat-bubble chat-${sender.toLowerCase()}`;

      const now = timeStr || new Date().toLocaleTimeString('en-GB');
      const authorClass = sender.toLowerCase() === 'user' ? 'user' : 'jarvis';
      const authorName = sender.toLowerCase() === 'user' ? 'SIR' : 'JARVIS';

      bubble.innerHTML = `
        <div class="bubble-author ${authorClass}">
          <span>${authorName}</span>
          <span>${now}</span>
        </div>
        <div class="bubble-text">${escapeHtml(cleanText)}</div>
      `;

      container.appendChild(bubble);
      container.scrollTop = container.scrollHeight;

      messageCount++;
      document.getElementById('msgCount').textContent = `[${String(messageCount).padStart(2, '0')} MSGS]`;
    }

