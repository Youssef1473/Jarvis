    // Holographic Photo Gallery Virtualized Controller (Zero-CLS & Zero-VRAM)
    const ERROR_FALLBACK_SVG = "data:image/svg+xml;utf8," + encodeURIComponent(
      `<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 100 100" fill="none">` +
      `<rect width="100" height="100" fill="#0f1420"/>` +
      `<path d="M50 30v25M50 68h.01" stroke="#ff3366" stroke-width="5" stroke-linecap="round"/>` +
      `<circle cx="50" cy="50" r="42" stroke="#ff3366" stroke-width="2" stroke-dasharray="4 4"/>` +
      `<text x="50" y="86" fill="#ff3366" font-size="8" font-family="monospace" text-anchor="middle">PAYLOAD ERROR</text>` +
      `</svg>`
    );

    class HolographicPhotoGallery {
      constructor() {
        this.photos = [];
        this.currentPhoto = null;
        this.observer = null;
        this.initObserver();
      }

      initObserver() {
        // 10% rootMargin as required by Council invariants
        const options = {
          root: domRefs.photoScrollContainer || document.getElementById('photoScrollContainer'),
          rootMargin: "10%",
          threshold: 0.01
        };

        this.observer = new IntersectionObserver((entries, observer) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const img = entry.target;
              const targetSrc = img.dataset.src;
              if (targetSrc) {
                img.src = targetSrc;
                img.removeAttribute("data-src");
              }
              observer.unobserve(img);
            }
          });
        }, options);
      }

      async loadGallery() {
        this.setStatus("FETCHING INTEL ARCHIVES...");
        try {
          const resp = await fetch("/api/photos");
          if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
          const data = await resp.json();
          this.photos = data.photos || [];
          if (domRefs.photoCounterBadge) {
            domRefs.photoCounterBadge.textContent = `${this.photos.length} ASSETS`;
          }
          this.render();
          this.setStatus(`SYNC COMPLETE (${this.photos.length} INDEXED)`);
        } catch (err) {
          console.error("[PhotoGallery] Failed to fetch archives:", err);
          this.setStatus("DATABASE SYNC ERROR");
        }
      }

      render() {
        const grid = domRefs.photoGrid || document.getElementById('photoGrid');
        if (!grid) return;
        grid.innerHTML = "";

        const emptyState = domRefs.photoEmptyState || document.getElementById('photoEmptyState');
        if (this.photos.length === 0) {
          if (emptyState) emptyState.classList.remove("hidden");
          return;
        }
        if (emptyState) emptyState.classList.add("hidden");

        const fragment = document.createDocumentFragment();

        this.photos.forEach(photo => {
          const tile = document.createElement("div");
          tile.className = "photo-tile aspect-square";
          tile.onclick = () => this.openLightbox(photo);

          const img = document.createElement("img");
          img.alt = photo.caption || photo.file_name || "Archived photo";
          img.dataset.src = `/api/photos/${photo.photo_id}`;
          img.src = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E";

          img.onload = () => {
            img.classList.add("loaded");
          };

          img.onerror = () => {
            img.src = ERROR_FALLBACK_SVG;
            img.classList.add("loaded");
            tile.style.borderColor = "rgba(255, 51, 102, 0.4)";
          };

          tile.appendChild(img);

          const badge = document.createElement("div");
          badge.className = "photo-tile-badge";
          const dim = photo.dimensions || "IMG";
          const sizeK = Math.round((photo.file_size || 0) / 1024);
          badge.innerHTML = `<span>${escapeHtml(dim)}</span><span>${sizeK}K</span>`;
          tile.appendChild(badge);

          fragment.appendChild(tile);

          if (this.observer) {
            this.observer.observe(img);
          }
        });

        grid.appendChild(fragment);
      }

      openLightbox(photo) {
        this.currentPhoto = photo;
        if (domRefs.modalPhotoTitle) domRefs.modalPhotoTitle.textContent = `INTEL // ${photo.file_name || photo.photo_id}`;
        if (domRefs.modalDim) domRefs.modalDim.textContent = photo.dimensions || "Unknown";
        if (domRefs.modalSize) domRefs.modalSize.textContent = `${Math.round((photo.file_size || 0) / 1024)} KB`;
        if (domRefs.modalDate) domRefs.modalDate.textContent = photo.created_at || "Recent";
        if (domRefs.modalId) domRefs.modalId.textContent = photo.photo_id;

        if (domRefs.modalCaptionText) {
          domRefs.modalCaptionText.textContent = photo.caption || "No visual description indexed. Click 'ANALYZE WITH VISION' to evaluate.";
        }

        if (domRefs.modalPhotoImg) {
          domRefs.modalPhotoImg.src = `/api/photos/${photo.photo_id}`;
          domRefs.modalPhotoImg.onerror = () => {
            domRefs.modalPhotoImg.src = ERROR_FALLBACK_SVG;
          };
        }

        if (domRefs.photoLightboxModal) {
          domRefs.photoLightboxModal.classList.remove("hidden");
        }
      }

      closeLightbox() {
        if (domRefs.photoLightboxModal) domRefs.photoLightboxModal.classList.add("hidden");
        if (domRefs.modalPhotoImg) domRefs.modalPhotoImg.src = "";
        this.currentPhoto = null;
      }

      async analyzeCurrentPhoto() {
        if (!this.currentPhoto) return;
        const btn = domRefs.analyzeVisionBtn;
        const captionText = domRefs.modalCaptionText;

        if (btn) {
          btn.disabled = true;
          btn.style.opacity = "0.5";
        }
        if (captionText) captionText.textContent = "Streaming visual tokens to Gemini Cloud Vision...";

        try {
          const resp = await fetch("/api/command", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ command: `describe photo ${this.currentPhoto.photo_id}` })
          });
          const data = await resp.json();
          if (captionText) captionText.textContent = `Analysis request dispatched (${data.status || 'queued'}). Listening for voice debrief...`;
        } catch (e) {
          if (captionText) captionText.textContent = `Vision analysis request failed: ${e.message}`;
        } finally {
          if (btn) {
            btn.disabled = false;
            btn.style.opacity = "1";
          }
        }
      }

      async pasteClipboard() {
        this.setStatus("EXTRACTING CLIPBOARD STREAM...");
        try {
          const resp = await fetch("/api/command", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ command: "save clipboard photo" })
          });
          this.setStatus("CLIPBOARD COMMAND SENT");
          setTimeout(() => this.loadGallery(), 1000);
        } catch (e) {
          this.setStatus("CLIPBOARD FAILED");
        }
      }

      refresh() {
        this.loadGallery();
      }

      setStatus(msg) {
        if (domRefs.galleryStatusMsg) domRefs.galleryStatusMsg.textContent = msg;
      }
    }

